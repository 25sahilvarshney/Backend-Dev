# Server Configuration
NODE_ENV=production
PORT=3000

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/shopeasy
MONGODB_URI_PROD=mongodb+srv://username:password@cluster.mongodb.net/shopeasy

# Session Configuration
SESSION_SECRET=your-super-secret-session-key-change-this
SESSION_MAX_AGE=1800000
SESSION_NAME=shopeasy.sid

# Security Configuration
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX=5

# CORS Configuration
ALLOWED_ORIGINS=https://shopeasy.com,https://api.shopeasy.com

# External Services
CDN_URL=https://cdn.shopeasy.com
PAYMENT_GATEWAY_URL=https://payment.shopeasy.com